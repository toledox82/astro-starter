---
import Layout from '@/layouts/Layout.astro'
---

<Layout
	title="Página não encontrada — Erro 404"
	description="A página que você procura não existe ou foi movida."
	noindex>
	<section class="flex min-h-svh flex-col items-center justify-center px-4 text-center">
		<p class="font-title text-8xl font-black text-secondary/20 lg:text-9xl">404</p>
		<h1 class="mt-4 font-title text-3xl font-bold text-secondary lg:text-4xl">
			Página não encontrada
		</h1>
		<p class="mt-4 max-w-lg text-balance text-secondary/60">
			A página que você está tentando acessar não existe, foi movida ou está temporariamente
			indisponível.
		</p>
		<a
			href="/"
			class="mt-8 rounded-default bg-accent px-6 py-3 font-semibold text-background transition-opacity hover:opacity-80">
			Voltar para a página inicial
		</a>
	</section>
</Layout>
