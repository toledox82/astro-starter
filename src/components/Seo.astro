---
import site from '@data/site.json'
const isHomePage = Astro.url.pathname === '/'
let { title, description, url = Astro.url, image, type, frontmatter, noindex } = Astro.props
title = isHomePage ? `${site.siteName} ${site.separator} ${site.title}` : `${title}`
description = isHomePage ? `${site.description}` : `${description}`
---

<title>{title || site.title}</title>
<meta name="description" content={description || site.description} />

<!-- SEO -->
<link rel="canonical" href={url} />

<!-- Open Graph -->
<meta property="og:site_name" content={site.siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description || site.description} />
<meta property="og:type" content={type || 'website'} />
<meta property="og:url" content={url} />
<meta property="og:image" content={image || site.image.src} />
<meta property="og:image:url" content={image || site.image.src} />
<meta property="og:image:secure_url" content={image || site.image.src} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={image?.alt || site.image.alt} />

<!-- Twitter -->
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description || site.description} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={image || site.image.src} />
<meta name="twitter:image:alt" content={title} />
<meta name="twitter:domain" content={import.meta.env.SITE} />

<!-- Robots -->
{noindex && <meta name="robots" content="noindex, nofollow" />}
